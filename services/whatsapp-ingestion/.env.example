# Copy to .env and adjust. ALL values are optional — the app runs fully without a .env (keyless mode).

# Log verbosity: trace|debug|info|warn|error
LOG_LEVEL=info

# --- Product catalog & database (paths relative to this folder; defaults are bundled) ---
# Product catalog CSV. Default is the bundled ./products.csv. Point elsewhere to use a different export.
PRODUCTS_CSV=./products.csv
# Local SQLite DB (aliases, processed messages, chat catalog, message history).
DB_PATH=./data.sqlite

# whatsapp-web.js session data (git-ignored). Scan the QR once; the session is reused after.
AUTH_DIR=./auth
# Where media/voice notes would be written (media download is currently unavailable — see HANDOFF §4).
STORE_DIR=./store

# --- Web server ---
WEB_PORT=3000
# 0.0.0.0 = reachable from another device on your network. Use 127.0.0.1 to restrict to this machine.
WEB_HOST=0.0.0.0

# --- Matching / roles ---
# Display-name substrings that mark a sender as warehouse/own staff (their bubbles sit on the right, no Extract button).
WAREHOUSE_NAMES=warehouse,shipping
# Emoji reactions that finalize an order on the Kanban board. UNCONFIRMED default — set to your team's real emoji.
FINALIZE_EMOJIS=✅,👍,🆗
# Optional allowlist of group chat ids (comma-separated), e.g. 12036...@g.us. Empty = all groups.
ALLOWED_GROUPS=

# --- Daily product-catalog import from the DDI export email ---
# Mirrors the customer-portal DDIImport job: once a day it fetches the "ZTMPEXP" product-export email
# and refreshes products.csv (hot-reloaded live, no restart). Reads Gmail READ-ONLY from "All Mail", so it
# never marks/moves/deletes and cannot interfere with the portal's own import. Skipped if no password below.
PRODUCT_IMPORT_ENABLED=true
PRODUCT_IMAP_HOST=imap.gmail.com
PRODUCT_IMAP_PORT=993
# The Gmail account that RECEIVES the DDI export (same mailbox the portal reads).
PRODUCT_IMAP_USER=ysddiexport@gmail.com
# Gmail APP PASSWORD (not the normal password). REQUIRED to enable the import. NEVER commit a real value.
PRODUCT_IMAP_PASSWORD=
# Only emails whose Subject contains this string are considered.
PRODUCT_SUBJECT_FILTER=ZTMPEXP
# Optional: also require this substring in the From address. Empty = match on subject alone.
PRODUCT_SENDER_FILTER=
# Local times (24h HH:MM) to run the import. Comma-separated for multiple runs a day. The DDI export arrives
# twice daily (after ~23:00 and ~11:00), so we run shortly after each.
PRODUCT_IMPORT_TIME=23:30,11:30
# On startup, run an immediate import if products.csv is older than this many hours (0 = never).
PRODUCT_IMPORT_CATCHUP_HOURS=24
# Reject a downloaded export with fewer than this many product rows (guards against overwriting with junk).
PRODUCT_IMPORT_MIN_ROWS=1000
# Email a run report (success OR failure) after every import. Leave PRODUCT_REPORT_TO empty to disable emails.
# SMTP defaults reuse the same Gmail account + app password as the IMAP read above (no extra secret needed).
PRODUCT_REPORT_TO=ruturajysps@gmail.com
# PRODUCT_REPORT_FROM=      # defaults to the SMTP user below
# PRODUCT_SMTP_HOST=smtp.gmail.com
# PRODUCT_SMTP_PORT=587
# PRODUCT_SMTP_USER=        # defaults to PRODUCT_IMAP_USER
# PRODUCT_SMTP_PASSWORD=    # defaults to PRODUCT_IMAP_PASSWORD

# --- AI order extraction (OPTIONAL — the app matches keyless without this) ---
# Set a key ONLY to enable the dormant Claude extraction seam (extractor.ts). NEVER commit a real key.
ANTHROPIC_API_KEY=
# Model used only if a key is set. Default is the most capable; claude-haiku-4-5 / claude-sonnet-5 cut cost.
EXTRACT_MODEL=claude-opus-4-8
