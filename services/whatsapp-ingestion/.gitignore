# Linked-device credentials — NEVER commit. Whoever holds these controls the WhatsApp session.
auth/
.wwebjs_auth/
.wwebjs_cache/

# Downloaded media / voice notes
store/

# Audit copies of daily product-export imports
imports/

# Deps & build
node_modules/
dist/

# Local SQLite DB (aliases, processed msgs, chat names)
data.sqlite
data.sqlite-*
# Hand-made copies taken before risky migrations. These hold EVERY captured customer message, and
# this repo is public — one `git add .` would publish the lot. Ignored by shape, not by name.
*.bak
*.bak-*
*.backup
data.sqlite.*

# Env & logs
.env
*.log
